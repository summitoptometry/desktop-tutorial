{
  "name": "electron-quick-start",
  "version": "1.0.0",
  "description": "A minimal Electron application",
  "main": "electron/main.js",
  "scripts": {
    "clean": "npx --yes rimraf node_modules",
    "reinstall": "npm run clean && npm install",
    "dev": "vite",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "postbuild": "python \"version control/version_builder.py\" --description \"自动构建版本\"",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder",
    "electron:pack": "electron-builder",
    "build:version": "npm run build",
    "list-versions": "python \"version control/version_manager_cli.py\" list",
    "deploy": "cd \"version control\" && .\\deploy_build.bat",
    "deploy:linux": "cd \"version control\" && source venv/bin/activate && python deploy_build.py",
    "deploy:interactive": "cd \"version control\" && .\\deploy_interactive.bat",
    "deploy:select": "cd \"version control\" && .\\deploy_select.bat",
    "deploy-version": "cd \"version control\" && venv\\Scripts\\activate.bat && python deploy_v2.py",
    "deploy:v1": "cd \"version control\" && venv\\Scripts\\activate.bat && python deploy_v2.py --version 20260111-1 --version-type v1",
    "deploy:v2": "cd \"version control\" && venv\\Scripts\\activate.bat && python deploy_v2.py --version 20260111-1 --version-type v2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": "https://github.com/electron/electron-quick-start",
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo"
  ],
  "author": "GitHub",
  "license": "CC0-1.0",
  "build": {
    "appId": "com.summit.eyehealth",
    "productName": "Summit胜密眼健康客户管理系统",
    "icon": "icon.ico",
    "directories": {
      "output": "release"
    },
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      "icon.ico",
      "icon.jpg",
      "icon.png"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Summit胜密眼健康客户管理系统"
    },
    "mac": {
      "icon": "icon.ico",
      "category": "public.app-category.business"
    },
    "linux": {
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "cross-env": "^7.0.3",
    "electron": "34.1.1",
    "electron-builder": "^25.1.8",
    "source-map": "latest",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-style-import": "^2.0.0",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "4.2.6",
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "pinyin-pro": "^3.27.0",
    "postcss-px-to-viewport": "^1.1.1",
    "print-js": "^1.6.0",
    "qrcode": "^1.5.4",
    "sass": "^1.89.2",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@10.12.2+sha1.12699edadad4a9899f8ae9dd8e8651d8976bf198"
}
